# Copie ce fichier vers .env uniquement si tu veux recevoir les evenements reels.
# Ne publie jamais ce fichier.
SE_CHANNEL_ID=
SE_CHANNEL_NAME=MaChaine
SE_TOKEN=
# jwt, apikey ou oauth2
SE_TOKEN_TYPE=jwt
# Liste separee par des virgules. Le token doit posseder les scopes correspondants.
SE_TOPICS=channel.activities,channel.session.update,channel.session.reset,channel.chat.message

# Optionnel : Streamlabs (Dashboard Streamlabs > Reglages > API Settings > Socket API Token)
SL_SOCKET_TOKEN=

PORT=4173

# Connexion Twitch (dev.twitch.tv/console/apps) - laisser vide desactive la connexion
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:4173/auth/twitch/callback

# Signature des cookies de session (chaine aleatoire longue)
SESSION_SECRET=

# Cle de chiffrement des jetons StreamElements/Streamlabs stockes (32 octets en base64)
# Generer avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Mettre a true uniquement derriere HTTPS (production)
COOKIE_SECURE=false

# Active la route de test POST /api/auth/dev-login (jamais en production)
ENABLE_DEV_LOGIN=false

