# Copie ce fichier vers .env uniquement si tu veux recevoir les evenements reels.
# Ne publie jamais ce fichier.
SE_CHANNEL_ID=
SE_CHANNEL_NAME=MaChaine
SE_TOKEN=
# jwt, apikey ou oauth2
SE_TOKEN_TYPE=jwt
# Liste separee par des virgules. Le token doit posseder les scopes correspondants.
SE_TOPICS=channel.activities,channel.session.update,channel.session.reset,channel.chat.message

# Optionnel : Streamlabs (Dashboard Streamlabs > Reglages > API Settings > Socket API Token)
SL_SOCKET_TOKEN=

# Connexion OAuth2 StreamElements (necessaire pour la section "Medias" de la
# bibliotheque, qui recupere les images/videos deja utilisees dans tes
# overlays StreamElements existants). Ces identifiants ne sont pas en
# self-service : demande-les au support StreamElements.
#
# IMPORTANT : StreamElements n'accepte pas localhost comme redirect_uri (cf.
# leur propre exemple https://github.com/StreamElements/authentication-samples,
# section "Change the hosts file"). Il faut donner au support une URI qui
# RESSEMBLE a un vrai domaine (ex: https://streamer-lab.local/auth/streamelements/callback),
# puis mapper ce domaine vers 127.0.0.1 dans le fichier hosts de ta machine :
#   Windows : C:\Windows\System32\drivers\etc\hosts (ouvrir en admin)
#   Ligne a ajouter : 127.0.0.1   streamer-lab.local
# Le navigateur redirigera ensuite vers https://streamer-lab.local/... (pas de
# certificat TLS local, la page affichera une erreur) : remplace alors
# manuellement https:// par http://streamer-lab.local:4173/... dans la barre
# d'adresse pour atteindre ce serveur local — meme limitation que documentee
# par StreamElements pour leur propre exemple.
#
# Laisser SE_OAUTH_CLIENT_ID vide desactive la fonctionnalite.
SE_OAUTH_CLIENT_ID=
SE_OAUTH_CLIENT_SECRET=
SE_OAUTH_REDIRECT_URI=https://streamer-lab.local/auth/streamelements/callback

PORT=4173

# Connexion Twitch (dev.twitch.tv/console/apps) - laisser vide desactive la connexion
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:4173/auth/twitch/callback

# Signature des cookies de session (chaine aleatoire longue)
SESSION_SECRET=

# Cle de chiffrement des jetons StreamElements/Streamlabs stockes (32 octets en base64)
# Generer avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Mettre a true uniquement derriere HTTPS (production)
COOKIE_SECURE=false

# Active la route de test POST /api/auth/dev-login (jamais en production)
ENABLE_DEV_LOGIN=false

