{
  "name": "streamer-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bac a sable local pour developper des Custom Widgets StreamElements et StreamLabs sans modifier les overlays publies.",
  "scripts": {
    "postinstall": "npm --prefix frontend install",
    "build": "npm --prefix frontend run build",
    "dev": "npm run build && concurrently -k \"npm --prefix frontend run build:watch\" \"node server.mjs --open\"",
    "start": "npm run build && node server.mjs",
    "dev:vue": "npm --prefix frontend run dev",
    "typecheck": "npm --prefix frontend run typecheck",
    "clean": "node scripts/clean.mjs",
    "reinstall": "npm run clean && npm install",
    "test": "node --test && npm run test:frontend",
    "test:frontend": "npm --prefix frontend run test"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "jquery": "^3.7.1",
    "socket.io-client": "^2.5.0",
    "ws": "^8.18.3"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "playwright": "^1.61.1",
    "sass": "^1.99.0"
  }
}
